arcade.db
arcade.db-journal
arcade.db-wal
arcade.db-shm
secret_key
# Einstellungen der Installation (legen die Installer an)
arcade.conf

# Python virtualenv (created by install.sh)
.venv/
__pycache__/
*.py[cod]
*.egg-info/

# Lokale Testversion (werkzeuge/testversion/bauen.py)
abw-arcade-lokal.html

# OS / editor cruft
.DS_Store
*.swp

# Lokale Claude-Code-Einstellungen (nur fuer diesen Rechner)
.claude/settings.local.json

# Arbeitsdateien von impeccable (Entwuerfe, Screenshots, Auslosungen).
# Versioniert werden nur Konfiguration und Oberflaechen-Briefs.
.impeccable/mocks/
.impeccable/review/
.impeccable/questions/
.impeccable/build/
.impeccable/live/
.impeccable/config.local.json

# Gebaute Verteilpakete (entstehen durch paket-bauen.sh)
abw-arcade.tar.gz
abw-arcade.zip

# Arbeitsverzeichnisse von Hintergrund-Agenten (git worktree)
.claude/worktrees/
