# Zeilenenden und Verteilpaket.
#
# Standard: keine automatische Umwandlung. Alle Dateien bleiben Byte für Byte
# so, wie sie im Repository liegen. Das schützt vor allem die DOOM-Daten
# (.wad, .wasm, .cfg), die eine Umwandlung von Zeilenenden unbemerkt
# beschädigen würde.
#
# Shell-Skripte brauchen LF. Mit CRLF (etwa durch core.autocrlf=true unter
# Windows) brechen sie mit "bad interpreter: /usr/bin/env bash^M" ab.

*       -text
*.sh    text eol=lf

# Windows-Skripte brauchen CRLF: cmd.exe liest Batch-Dateien mit LF-Enden
# unzuverlässig. git archive schreibt sie so auch ins tar.gz und ins zip,
# unabhängig vom System, auf dem das Paket gebaut wird.
*.cmd      text eol=crlf
*.bat      text eol=crlf
*.ps1      text eol=crlf
# Doppelklick-Skripte für den macOS-Finder sind Shell-Skripte: LF.
*.command  text eol=lf

# Binär: keine Umwandlung, kein Text-Diff, kein Merge.
*.wad      binary
*.wasm     binary

# Nicht im Verteilpaket (git archive): Dateien für die Entwicklung.
# Verzeichnisse verankert und ohne Schrägstrich am Ende, weil
# "verzeichnis/" in .gitattributes nicht zuverlässig greift.
.gitattributes  export-ignore
.gitignore      export-ignore
/.github        export-ignore
/tests          export-ignore
/docs           export-ignore
/werkzeuge      export-ignore
